{
  "name": "piano-desde-cero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aprender teoria musical y piano desde cero, local-first y sin profesor.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "validate:content": "tsx scripts/validate-content.ts",
    "index:content": "tsx scripts/build-course-index.ts",
    "budget": "npm run build && node scripts/check-bundle.mjs",
    "fetch:samples": "node scripts/fetch-samples.mjs",
    "fetch:samples:dry": "node scripts/fetch-samples.mjs --dry-run",
    "audit:audio": "node scripts/verify-audio.mjs",
    "audit:licenses": "tsx scripts/audit-licenses.ts",
    "estado": "node scripts/estado.mjs"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tonal": "6.5.1",
    "tone": "15.1.22",
    "ts-fsrs": "6.0.0",
    "vexflow": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "license-checker": "^25.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "read-package-json": {
      "glob": "^7.2.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
